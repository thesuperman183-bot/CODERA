# =============================================================================
# Code Review Agent - Production Environment Variable Specification
# =============================================================================
# Copy this file to .env and populate with your verified credentials.
# Never commit active credentials, secrets, or .env to version control.

# -----------------------------------------------------------------------------
# 1. Groq Cloud LLM Configuration
# -----------------------------------------------------------------------------
# High-throughput LPU inference for automated code reviews.
# Required models: llama-3.3-70b-versatile, qwen-2.5-32b, deepseek-r1-distill-llama-70b
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_TIMEOUT_SECONDS=30.0

# -----------------------------------------------------------------------------
# 2. Hindsight Cloud Memory Configuration
# -----------------------------------------------------------------------------
# Contextual semantic vector recall and permanent learning memory banks.
HINDSIGHT_API_KEY=hsk_your_hindsight_api_key_here
HINDSIGHT_BASE_URL=https://cloud.vectorize.io/api/v1
HINDSIGHT_BANK_ID=default
HINDSIGHT_TIMEOUT_SECONDS=15.0

# -----------------------------------------------------------------------------
# 3. Neon PostgreSQL Database Configuration (Source of Truth)
# -----------------------------------------------------------------------------
# Pooled connection string for high-concurrency API server execution.
DATABASE_URL=postgresql://neondb_owner:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require
# Direct unpooled connection string for schema migrations (Alembic).
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require
NEON_BRANCH=production

# -----------------------------------------------------------------------------
# 4. Authentication & RBAC (Neon Managed Better Auth & Personal Access Tokens)
# -----------------------------------------------------------------------------
NEON_AUTH_BASE_URL=https://auth.myneon.app/auth/v1/projects/your_project_id
NEON_AUTH_JWKS_URL=https://auth.myneon.app/auth/v1/projects/your_project_id/.well-known/jwks.json

# -----------------------------------------------------------------------------
# 5. Application Runtime & Production CORS
# -----------------------------------------------------------------------------
# Set to 'production' in deployed environments to enforce strict CORS and secure headers.
ENVIRONMENT=production
# JSON array of authorized origins permitted to access FastAPI endpoints.
CORS_ORIGINS=["https://your-dashboard-domain.com","http://localhost:3000","http://127.0.0.1:3000"]

# -----------------------------------------------------------------------------
# 6. GitHub Integration & Pull Request Intelligence
# -----------------------------------------------------------------------------
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_APP_ID=your_github_app_id
GITHUB_PRIVATE_KEY=""
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret
GITHUB_API_BASE_URL=https://api.github.com

# -----------------------------------------------------------------------------
# 7. Frontend Client Environment Variables (frontend/.env.local)
# -----------------------------------------------------------------------------
# Deployed FastAPI backend URL accessed by Next.js client.
NEXT_PUBLIC_API_URL=https://api.your-code-review-agent.com

# -----------------------------------------------------------------------------
# 8. CLI Terminal Client Environment Variables
# -----------------------------------------------------------------------------
# Configure CLI target API URL across terminal sessions:
REVIEW_AGENT_API_URL=https://api.your-code-review-agent.com
